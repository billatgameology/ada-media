# ── ada-media credentials ──────────────────────────────────────────────
# Copy this file to `.env` and fill in values as you connect platforms.
# `.env` is gitignored — never commit it.
# Step-by-step account setup for every key below: guide/SETUP.md

# ── X / Twitter ────────────────────────────────────────────────────────
# Pay-per-use since Feb 2026 (no free tier for new developers).
# Add a few dollars of credits, then: keep links OUT of posts (links cost $0.20).
# console.x.com → your app → Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Meta (one app covers Instagram + Threads + Facebook) ───────────────
# developers.facebook.com → your app → see guide/SETUP.md
META_APP_ID=
META_APP_SECRET=

# Instagram — "Instagram API with Instagram Login" (graph.instagram.com)
# Your IG account must be a professional (business) account.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Threads — "Threads API" (graph.threads.net)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Facebook Page — needs Meta App Review for public posts (see guide/PLAN.md)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ── TikTok ─────────────────────────────────────────────────────────────
# developers.tiktok.com → your app → Login Kit + Content Posting API.
# TIKTOK_REDIRECT_URI must exactly match the redirect URI registered in the portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost/ada
# One-time: `python scripts/ada.py auth tiktok` (tokens auto-refresh after that)
TIKTOK_REFRESH_TOKEN=

# ── YouTube ────────────────────────────────────────────────────────────
# console.cloud.google.com → project → enable "YouTube Data API v3"
# → OAuth client (type: Desktop app)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# One-time: `python scripts/ada.py auth youtube` (opens a browser to consent)
